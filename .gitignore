# --- OS / editor cruft -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editor and IDE state
.idea/
.vscode/
*.swp
*.swo
*~

# --- Secrets and local environment ------------------------------------------
# Never commit credentials or per-machine overrides
.env
.env.*
*.env
!.env.example
rclone/rclone.conf
*.pem
*.key

# --- Logs and runtime output -------------------------------------------------
*.log
logs/

# --- rclone exercise ---------------------------------------------------------
# Large/generated transfer fixtures and the copy target are not source.
# The small text/JSON fixtures under rclone/source/ are kept on purpose.
rclone/**/*.bin
rclone/dest/
rclone/data/
rclone/cache/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- VM / container scratch --------------------------------------------------
*.qcow2
*.img
.vagrant/
