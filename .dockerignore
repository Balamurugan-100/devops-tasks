!**/.env.example
!**/*.env.example
**/rclone.conf
**/*.pem
**/*.key

# --- Logs, caches, and generated transfer data -------------------------------
**/*.log
**/logs/
rclone/**/*.bin
rclone/source/
rclone/dest/
rclone/data/
rclone/cache/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/

# --- CI and VM scratch --------------------------------------------------------
.github/
**/*.qcow2
**/*.img
**/.vagrant/
