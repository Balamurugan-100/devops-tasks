# --- Version control and repo metadata --------------------------------------
**/.git
.gitignore
.gitattributes
.dockerignore

# --- Documentation and task assets not needed in an image -------------------
**/*.md
cloud-init/

# --- OS / editor state --------------------------------------------------------
**/.DS_Store
**/._*
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/*~

# --- Secrets and local environment ------------------------------------------
**/.env
**/.env.*
